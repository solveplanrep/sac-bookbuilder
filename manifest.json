{
  "name": "SISGPI Book Builder",
  "description": "Gera book em PDF (1 página por projeto AMZ) a partir de Data Binding ao S00_CAPEX",
  "newInstancePrefix": "BookBuilder",
  "vendor": "Solveplan",
  "license": "internal-use",
  "id": "com.solveplan.sisgpi.bookbuilder",
  "version": "2.2.0",
  "icon": "",
  "eula": "",
  "webcomponents": [
    {
      "kind": "main",
      "tag": "com-solveplan-sisgpi-bookbuilder",
      "url": "https://solveplanrep.github.io/sac-bookbuilder/widget.js",
      "integrity": "",
      "ignoreIntegrity": true
    }
  ],
  "properties": {
    "headerTitle": {
      "type": "string",
      "description": "Título da capa do book",
      "default": "Card SISGPI - Portfólio de Projetos"
    },
    "subtitleTemplate": {
      "type": "string",
      "description": "Subtítulo (use {count} para o número de projetos)",
      "default": "{count} projetos analisados"
    },
    "projectFilterPrefix": {
      "type": "string",
      "description": "Prefixo dos projetos a incluir (ex: AMZ.)",
      "default": "AMZ."
    },
    "userEmail": {
      "type": "string",
      "description": "Email do usuário (rodapé)",
      "default": ""
    }
  },
  "methods": {
    "inspectDataBinding": {
      "description": "Mostra a estrutura do Data Binding na UI do widget (debug)",
      "parameters": [],
      "returnType": "void"
    },
    "generateBook": {
      "description": "Gera o book PDF a partir dos dados do Data Binding",
      "parameters": [
        { "name": "versionLabel", "type": "string", "description": "Label da versão (ex: RF3T25_Oficial)" }
      ],
      "returnType": "void"
    }
  },
  "events": {
    "onBookGenerated": { "description": "Disparado quando o PDF foi gerado" },
    "onError": { "description": "Disparado em caso de erro" }
  },
  "dataBindings": {
    "myDataBinding": {
      "feeds": [
        {
          "id": "dimensions",
          "description": "Dimensões (S00_PROJECT + S00_ACCOUNT)",
          "type": "dimension"
        },
        {
          "id": "measures",
          "description": "Medidas (Montante)",
          "type": "mainStructureMember"
        }
      ]
    }
  }
}
